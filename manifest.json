  "coverage": {
    "geography": "primarily US, with selected international market contrasts",
    "categories": [
      "skincare",
      "sun care",
      "fragrance",
      "hair & scalp",
      "makeup",
      "body & bath",
      "oral care",
      "deodorant"
    ],
    "signal_type": "consumer attention \u2014 search, video, social, forum discussion",
    "not_covered": [
      "sell-through and retail measurement",
      "conversion and repeat purchase",
      "retailer, region and price-tier splits",
      "first-party or brand-specific performance"
    ],
    "scope_note": "Beauty and personal care only. Food & beverage, supplements and women's health knowledge exists but is parked in _parked/ \u2014 depth in one category beats thin coverage of many."
